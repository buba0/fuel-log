          },
          "expr": "fuel_log_total_liters{user=\"MONITORED_USERNAME\",car_id=\"all\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{car}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "litre",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
